# Copy to .env (docker compose reads it). All variables are optional except when noted.
# Image used by docker compose when not building locally (CI pushes lanhlungbang/finassis)
FINASSIS_IMAGE=lanhlungbang/finassis:latest
FINASSIS_ENV=dev
FINASSIS_LOG_LEVEL=INFO
FINASSIS_PUBLIC_BASE_URL=http://localhost:8000

# inside compose these are set by the service definitions; for local `finassis api` use these
FINASSIS_DATABASE_URL=postgresql://finassis:finassis@localhost:5432/finassis
FINASSIS_REDIS_URL=redis://localhost:6379/0

# Telegram (one bot, ours). Leave empty to disable the channel.
FINASSIS_TELEGRAM_BOT_TOKEN=
FINASSIS_TELEGRAM_WEBHOOK_SECRET=change-me

# Bootstrap: if unset, an admin key is generated and printed once on first start
FINASSIS_BOOTSTRAP_ADMIN_TELEGRAM_ID=
FINASSIS_BOOTSTRAP_ADMIN_API_KEY=

# LLM (recipe compiler, Phase 1)
FINASSIS_AI_API_KEY=
